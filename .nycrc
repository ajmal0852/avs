{
  "all": true,
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server.ts"
  ],
  "exclude": [
    "**/*.d.ts",
    "dist/**",
    "node_modules/**"
  ],
  "reporter": [
    "text",
    "lcov",
    "json-summary"
  ],
  "lines": 90,
  "statements": 90,
  "functions": 90,
  "branches": 90
}
